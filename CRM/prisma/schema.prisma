generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── USERS & AUTH ───────────────────────────────────────────
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  avatarUrl      String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspaceMembers WorkspaceMember[]
  ownedWorkspaces  Workspace[]
  activities       ActivityLog[]
  affiliateProfile Affiliate?
}

// ─── WORKSPACES ─────────────────────────────────────────────
model Workspace {
  id        String          @id @default(cuid())
  name      String
  type      String          // individual | freelancer | business | agency
  ownerId   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  owner          User              @relation(fields: [ownerId], references: [id])
  members        WorkspaceMember[]
  clients        Client[]
  campaigns      Campaign[]
  contents       Content[]
  socialAccounts SocialAccount[]
  leads          Lead[]
  products       Product[]
  automationRules AutomationRule[]
  trackingAssets TrackingAsset[]
  seoKeywords    SEOKeyword[]
  ppcCampaigns   PPCCampaign[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   // owner | admin | manager | member
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// ─── CLIENTS (for freelancers & agencies) ───────────────────
model Client {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  phone       String?
  company     String?
  industry    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
}

// ─── CAMPAIGN ENGINE ────────────────────────────────────────
model Campaign {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String?
  name        String
  goal        String   // awareness | sales | engagement | traffic | leads
  type        String   // social | influencer | offline | email | sms | ppc | mixed
  budget      Float?
  platforms   String   // JSON array of platform names
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("draft") // draft | active | paused | completed | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client             Client?              @relation(fields: [clientId], references: [id])
  contents           Content[]
  distributions      Distribution[]
  metrics            CampaignMetric[]
  influencerCampaign InfluencerCampaign?
  offlineCampaign    OfflineCampaign?
}

// ─── CONTENT ENGINE (CREATE ONCE) ───────────────────────────
model Content {
  id            String   @id @default(cuid())
  workspaceId   String
  campaignId    String?
  captionMaster String
  mediaUrl      String?
  mediaType     String?  // image | video | text | link
  hashtags      String?
  link          String?
  status        String   @default("draft") // draft | ready | published | archived
  scheduledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign?    @relation(fields: [campaignId], references: [id])
  variants  Variant[]
}

// ─── VARIANT ENGINE (CRITICAL LAYER) ────────────────────────
model Variant {
  id        String   @id @default(cuid())
  contentId String
  platform  String   // instagram | facebook | youtube | youtube_shorts | tiktok | twitter | linkedin | whatsapp | sms | email
  caption   String
  mediaUrl  String?
  format    String?  // 9:16 | 1:1 | 16:9 | 4:5
  title     String?  // for YouTube
  seoTags   String?  // JSON for YouTube SEO
  status    String   @default("pending") // pending | ready | published | failed
  createdAt DateTime @default(now())

  content       Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  distributions Distribution[]
}

// ─── DISTRIBUTION ENGINE ────────────────────────────────────
model Distribution {
  id          String   @id @default(cuid())
  variantId   String
  campaignId  String?
  platform    String
  method      String   // auto | assisted
  status      String   @default("pending") // pending | queued | publishing | published | failed | assisted_ready
  publishedAt DateTime?
  externalId  String?  // post ID from the platform
  errorMsg    String?
  createdAt   DateTime @default(now())

  variant  Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])
}

// ─── SOCIAL ACCOUNTS ────────────────────────────────────────
model SocialAccount {
  id           String   @id @default(cuid())
  workspaceId  String
  platform     String   // instagram | facebook | youtube | tiktok | twitter | linkedin
  accountType  String   // personal | business | creator
  accountName  String
  accessToken  String?
  refreshToken String?
  externalId   String?
  followers    Int      @default(0)
  isConnected  Boolean  @default(true)
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── ANALYTICS ENGINE ───────────────────────────────────────
model CampaignMetric {
  id           String   @id @default(cuid())
  campaignId   String
  platform     String
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  engagement   Int      @default(0)
  conversions  Int      @default(0)
  spend        Float    @default(0)
  revenue      Float    @default(0)
  date         DateTime
  createdAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ─── LEADS & CRM ────────────────────────────────────────────
model Lead {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  phone       String?
  company     String?
  position    String?
  source      String?  // website | referral | social | ad | cold_call | event
  status      String   @default("new") // new | contacted | qualified | proposal | negotiation | won | lost
  value       Float?
  notes       String?
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  communications Communication[]
  deals          Deal[]
}

model Communication {
  id        String   @id @default(cuid())
  leadId    String
  type      String   // email | sms | whatsapp | call | video
  subject   String?
  body      String?
  outcome   String?
  direction String   @default("outbound") // inbound | outbound
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// ─── PRODUCTS & DEALS ───────────────────────────────────────
model Product {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  price       Float
  category    String?
  status      String   @default("active") // active | inactive | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals     Deal[]
}

model Deal {
  id        String   @id @default(cuid())
  leadId    String
  productId String
  value     Float
  status    String   @default("open") // open | won | lost
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── AUTOMATION ENGINE ──────────────────────────────────────
model AutomationRule {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  trigger     String   // booking_created | invoice_overdue | campaign_launched | lead_created | lead_status_changed
  conditions  String?  // JSON conditions
  action      String   // send_whatsapp | send_sms | send_email | create_task | update_lead
  actionConfig String  // JSON action configuration
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationLogs AutomationLog[]
}

model AutomationLog {
  id         String   @id @default(cuid())
  ruleId     String
  status     String   // triggered | success | failed
  payload    String?  // JSON
  errorMsg   String?
  executedAt DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

// ─── TRACKING LAYER ─────────────────────────────────────────
model TrackingAsset {
  id          String   @id @default(cuid())
  workspaceId String
  type        String   // utm_link | qr_code | promo_code | short_link | call_number
  name        String
  value       String   // the actual link/code/number
  campaignId  String?
  clicks      Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── INFLUENCER MODULE ──────────────────────────────────────
model InfluencerCampaign {
  id           String   @id @default(cuid())
  campaignId   String   @unique
  totalBudget  Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign     Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencers  InfluencerAssignment[]
}

model InfluencerAssignment {
  id                   String   @id @default(cuid())
  influencerCampaignId String
  influencerName       String
  influencerHandle     String
  platform             String
  deliverables         String   // JSON array of deliverable descriptions
  trackingLink         String?
  payoutAmount         Float?
  payoutStatus         String   @default("pending") // pending | paid | cancelled
  postCount            Int      @default(0)
  impressions          Int      @default(0)
  engagement           Int      @default(0)
  createdAt            DateTime @default(now())

  influencerCampaign InfluencerCampaign @relation(fields: [influencerCampaignId], references: [id], onDelete: Cascade)
}

// ─── AFFILIATE MODULE ───────────────────────────────────────
model Affiliate {
  id             String   @id @default(cuid())
  userId         String   @unique
  referralCode   String   @unique
  commissionRate Float    @default(0.1)
  totalEarnings  Float    @default(0)
  createdAt      DateTime @default(now())

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversions AffiliateConversion[]
}

model AffiliateConversion {
  id          String   @id @default(cuid())
  affiliateId String
  amount      Float
  commission  Float
  status      String   @default("pending") // pending | approved | paid | rejected
  createdAt   DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
}

// ─── SEO MODULE ─────────────────────────────────────────────
model SEOKeyword {
  id          String   @id @default(cuid())
  workspaceId String
  keyword     String
  volume      Int?
  difficulty  Int?
  currentRank Int?
  targetRank  Int?
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── PPC MODULE ─────────────────────────────────────────────
model PPCCampaign {
  id          String   @id @default(cuid())
  workspaceId String
  platform    String   // google_ads | meta_ads
  externalId  String?
  name        String
  budget      Float
  spend       Float    @default(0)
  clicks      Int      @default(0)
  impressions Int      @default(0)
  conversions Int      @default(0)
  cpc         Float?
  ctr         Float?
  roi         Float?
  status      String   @default("active") // active | paused | ended
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── OFFLINE MARKETING ──────────────────────────────────────
model OfflineCampaign {
  id         String   @id @default(cuid())
  campaignId String   @unique
  channel    String   // tv | radio | billboard | print | event
  location   String?
  airDate    DateTime?
  qrCodeUrl  String?
  shortLink  String?
  promoCode  String?
  callNumber String?
  scans      Int      @default(0)
  calls      Int      @default(0)
  redemptions Int     @default(0)
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ─── ACTIVITY LOG ───────────────────────────────────────────
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  type      String   // campaign_created | content_published | lead_added | communication_sent | automation_triggered
  message   String
  metadata  String?  // JSON extra data
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
