# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# DynamoDB
AWS_REGION=us-east-1
DYNAMODB_TABLE_PREFIX=SocialSync
# Only set for local development against DynamoDB Local (e.g. http://localhost:8000).
# Leave unset in Amplify — the app uses the real AWS endpoint + the hosting IAM role there.
DYNAMODB_ENDPOINT=
# Only needed for DynamoDB Local, which requires *some* credentials even though it ignores them.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Scheduling worker (Phase 2)
CRON_SECRET=

# Social publishing (Phase 1)
META_APP_ID=
META_APP_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Email (Phase 4)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Billing (Phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
